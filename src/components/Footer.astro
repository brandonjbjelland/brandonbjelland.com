---
import { SITE } from '../consts';
const year = new Date().getFullYear();
---
<footer>
  <div class="container wide row">
    <span><span class="ok">[ok]</span> © {year} {SITE.author}</span>
    <span class="links">
      <a href={SITE.links.github}>GitHub</a>
      <a href={SITE.links.linkedin}>LinkedIn</a>
      <a href={`mailto:${SITE.email}`}>Email</a>
      <a href="/rss.xml">RSS</a>
      <a href="/llms.txt">llms.txt</a>
    </span>
  </div>
</footer>
<style>
  footer { border-top: 1px dashed var(--border); color: var(--faint); font-size: 0.88rem; }
  .row { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; padding-top: 1.5rem; padding-bottom: 2rem; }
  .links { display: flex; gap: 1rem; }
  a { color: var(--muted); border: 0; }
  a:hover { color: var(--accent); }
  .ok { color: var(--accent); }
</style>
