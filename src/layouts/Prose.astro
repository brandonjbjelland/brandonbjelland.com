---
import Base from './Base.astro';
const { frontmatter } = Astro.props;
---
<Base title={frontmatter.title} description={frontmatter.description} markdown={frontmatter.markdown}>
  <article class="prose"><slot /></article>
</Base>
<style>
  .prose :global(h1 + p > img:only-child) {
    display: block;
    width: 200px;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid var(--border);
    box-shadow: 4px 4px 0 var(--accent-soft);
  }
</style>
